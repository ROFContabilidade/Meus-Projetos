@echo off
chcp 65001 >nul
title ROF - Instalar o conversor de extratos
rem Arquivo unico: nao precisa extrair nada. Instala em <pasta EXTRATOS>\_ferramentas,
rem instala o Python (se faltar), cria a tarefa de 5 em 5 minutos e testa com um extrato de exemplo.
set "TMPI=%TEMP%\ROF-Conversor-instalar"
set "ESTE=%~f0"
echo.
echo  Preparando a instalacao ...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$d=$env:TMPI; Remove-Item -LiteralPath $d -Recurse -Force -ErrorAction SilentlyContinue; New-Item -ItemType Directory -Force -Path $d | Out-Null; $nome=$null; $b=@{}; foreach($l in Get-Content -LiteralPath $env:ESTE){ if($l -match '^::ARQ (.+)$'){ $nome=$Matches[1]; $b[$nome]=New-Object Text.StringBuilder } elseif($nome -and $l -match '^::B (.+)$'){ [void]$b[$nome].Append($Matches[1]) } }; foreach($k in $b.Keys){ [IO.File]::WriteAllBytes((Join-Path $d $k),[Convert]::FromBase64String($b[$k].ToString())) }; Get-ChildItem -LiteralPath $d | Unblock-File; if($b.Count -lt 8){ exit 1 }" || goto erro
powershell -NoProfile -ExecutionPolicy Bypass -File "%TMPI%\instalar.ps1" || goto erro
echo.
pause
exit /b 0

:erro
echo.
echo  ERRO na instalacao. Tire um print desta tela e envie.
pause
exit /b 1

